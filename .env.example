# Copy this file to .env and fill it in. .env is git-ignored; never commit real keys.

# --- PayPal sandbox ---
# developer.paypal.com -> Apps & Credentials -> (Sandbox toggle) -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# Sandbox test card used by scripts/check-sandbox.mjs to create paid orders without a browser.
# If this one is declined, generate another at https://developer.paypal.com/tools/sandbox/card-testing/
TEST_CARD_NUMBER=4111111111111111
TEST_CARD_EXPIRY=2030-12

# --- AI (Google Gemini) ---
GEMINI_API_KEY=

# --- AG Grid Enterprise trial license key ---
AG_GRID_LICENSE_KEY=

# --- Database (local Postgres; Render Postgres in production) ---
DATABASE_URL=postgres://refundsout:CHANGE_ME@localhost:5432/refundsout
